// HKDF, RFC 5869: https://www.rfc-editor.org/rfc/rfc5869
//
// Extract and expand are exported separately because TLS 1.3 uses them
// separately — it extracts once per handshake secret and expands many times.
import {
  "moonbitstack/mooncrypt/spec",
  "moonbitstack/mooncrypt/mac/hmac",
}

import {
  "moonbitstack/moonbase/base16",
  "moonbitstack/mooncrypt/hash/sha1",
  "moonbitstack/mooncrypt/hash/sha2",
} for "test"
