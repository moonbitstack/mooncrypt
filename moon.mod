  "salsa20",
  "des",
  "3des",
  "blowfish",
  "camellia",
  "rc4",
  "sm2",
  "sm3",
  "sm4",
  "sha1",
  "sha2",
  "sha256",
  "sha512",
  "sha3",
  "keccak",
  "blake2",
  "blake3",
  "md5",
  "ripemd160",
  "streebog",
  "whirlpool",
  "hmac",
  "cmac",
  "gmac",
  "kmac",
  "siphash",
  "hkdf",
  "pbkdf2",
  "scrypt",
  "argon2",
  "bcrypt",
  "rsa",
  "dsa",
  "ecdsa",
  "ed25519",
  "ed448",
  "schnorr",
  "x25519",
  "x448",
  "ecdh",
  "diffie-hellman",
  "ml-kem",
  "kyber",
  "ml-dsa",
  "dilithium",
  "slh-dsa",
  "sphincs",
  "post-quantum",
  "pqc",
  "drbg",
  "otp",
  "totp",
  "hotp",
  "crc32",
  "crc16",
  "adler32",
  "fnv",
