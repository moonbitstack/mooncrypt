name = "moonbitstack/mooncrypt"

version = "0.4.3"

readme = "README.md"

repository = "https://github.com/moonbitstack/mooncrypt"

license = "Apache-2.0"

keywords = [
  "crypto",
  "cryptography",
  "hash",
  "sha256",
  "hmac",
  "ed25519",
  "ecdsa",
  "rsa",
  "jwt",
  "moonbit",
]

description = "Cryptographic algorithms for MoonBit, one per package."

import {
  "moonbitstack/moonbase@0.4.0",
  "moonbitstack/moondate@0.1.0",
}

source = "src"
