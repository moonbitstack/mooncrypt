///|
fn raw(s : String) -> Bytes {
  @base16.decode_lossy(s)
}

///|
/// A 1024-bit and a 2048-bit key, carried as their numbers. Both were generated
/// once; every signature below came from a third-party library using exactly
/// these numbers.
let n1024 : String = "e22848d7a0daa60384eabd73d0e43cfd83f3b91dbb2c855ed6f49cb51a019a9310d9dc700e674031fe19aaa784ddb6201855a75ec8aebba620cb8abad6d8efb2b745b38b80bb92f472f5e6ee359e40858159fd080b0d9eb61e7dc01eab625ece0d2d27f32371c6892650aa4495304418f88fc95877be02706c1086978d36803f"

///|
let d1024 : String = "8f7b7573707727fa759aa465d532e8cb02ab5f57d087977a2b307837a1ef408d6b947cf98ef9cccdaae3c7d48e4447a72729388db70ebcb8d277b06587a78cb2893f46647c904a325760ac285b58085698ebd9452c47a27fd780bb3d667bc7d7d4f9333a369b8942a8249ff88f031ba96a7b16c52e1010b6f84a2c755ebdacb9"

///|
let n2048 : String = ""

///|
let d2048 : String = ""

///|
let e : String = "010001"

///|
fn digest_of(name : String) -> @rsa.Digest {
  match name {
    "Sha1" => Sha1
    "Sha224" => Sha224
    "Sha256" => Sha256
    "Sha384" => Sha384
    _ => Sha512
  }
}

///|
fn modulus(bits : Int) -> (String, String) {
  if bits == 1024 {
    (n1024, d1024)
  } else {
    (n2048, d2048)
  }
}

///|
/// PKCS#1 v1.5 is deterministic, so each signature is reproduced exactly as well
/// as verified. A wrong `DigestInfo` prefix would fail both halves.
test "RSA PKCS#1 v1.5 matches a third-party signer" {
  let cases = [
    (
      1024, "Sha1", "", "6504a0c4815d4c7bec8bb935b37883223818958e5a6810224626b7ad3e15664eaed665cc188a692cbb32409673c1c48113b07872de0e1a1653b62ecc406e98e719a7a1a6c2c39066cd03d2c319195cd2e84e789e524ced4cb1a4fae4b041225c5875e3d8b1f94586a307a81279013f585dd8ca1f5aa28ef9d04ade1d0940715f",
    ),
    (
      1024, "Sha1", "616263", "d9096765f3b983e424d4c331f9a3dc302409cb28b582735e519cdd4bb614a820f68ac87303d4bf99a4733387f663c90250364c00a808935e4756cda1527b96cb1d379efcecbe345c58985ab29efe774bac8c3ac38bd18a465c02ac147076f844a98d62bf818ee951719fbbf7512288137f3364f11b474205f8e613bc64cb38d7",
    ),
    (
      1024, "Sha1", "4d6f6f6e426974", "384194f9c746c695e6986cbc11dac16cc4d848a095e0f980ddabbeb0c3ff27f845c8b78d0a3b5b1d694bace89b224b54b532b22434d98e420f875d2281a57f5c2415d1fd066864ff59c79e805d408d8ec4d5b36ef7238309818d4b0c06edd6fabe24c1abf7b6bed9b2a3c19ed0eef88d39321688aecfd35e0c873d372f785f5c",
    ),
    (
      1024, "Sha1", "",
      "0f7ce19a1074e60064a8c6dfd4d2fc0c65476630685fd947ca6db6f52a9aa66b4f38b269c48a6514244413231b682e6b915eb0737f703f85359ac057bb0e92f929490fed92b1aea7841a626e1d2674fcac4fdfcbf9898f62dd3ff549b2d404d13064361ef4be7394598ba066a10a98f7e386cb7716d3d9364944afb351cc754c",
    ),
    (
      1024, "Sha224", "", "1589e1216d9380e51c981a1207fc4802c4de531cdc32f4daeb1294f57be5a2a318e6c1f3a2530864eaf586b7b3419e2da20392b4182411b0d15ae820f6458265a3fb1dd130b7d30be06118dbdad8586969659603ad8f5c7b687c5d8c93d154790ecfdc63acd569277c69cec411daab217110985ff5862ef8c3332e8369d9ee92",
    ),
    (
      1024, "Sha224", "616263", "016d784a4318a2d6ee81f08224166ff60a9113338890e410a013dd917f1f7c8d6d356f3e785d93737eb27cbaa45d8c33ddc2d790beebae567a06e5c929e460fd1cd53b0f347a88bb95b7f27d9432d147338a9250972fde05d236c238910b5ee58364974c09f590e6c00be1cf5230c349691bd6902cf7c26e3db5468bbecd652b",
    ),
    (
      1024, "Sha224", "4d6f6f6e426974", "becf228ce2d930363c5550305272ca8886dbae29729dfd0882624ac578e6de10ec57403189b72f13789fa236a12a069575c793a741f56217e3eb9ced352e97926562a54ae80883cffdf3b38ec41c9145b76ed40523665b205184f50b1be88f767c6c3e6b14b9ee6bbf260a246c0a88ba6c42242dfa449fcc6e359bfffb61e78a",
    ),
    (
      1024, "Sha224", "",
      "895126d5ba75041d3680432874aeb7afcb2d7f7bdb1b30d96ae74ff4c3009208db5bc703f06aa0a53b507bc25894a101b19d7b719d59ec83b0e2f016f50e3ee0b4b331064665a4a9a183c9b87c220b4b4fc7d263c54d985cc59763a6bb00cdc567c49e9c8a971ddee81e3e555a0863d2a6131c563db6d12f60ef8dc5aa671ada",
