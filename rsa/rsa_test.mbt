    ),
    (
      2048, "Sha384", "4d6f6f6e426974", "",
    ),
    (
      2048, "Sha384", "",
      "",
    ),
    (
      2048, "Sha512", "", "",
    ),
    (
      2048, "Sha512", "616263", "",
    ),
    (
      2048, "Sha512", "4d6f6f6e426974", "",
    ),
    (
      2048, "Sha512", "",
      "",
    ),
  ]
  for case in cases {
    let (bits, name, msg, want) = case
    let (n, _) = modulus(bits)
    let digest = digest_of(name)
    let pk = @rsa.PublicKey::new(
      raw(n)[:],
      raw(e)[:],
      digest~,
      scheme=Pss(salt=0),
    )
    assert_true(pk.verify(raw(msg)[:], raw(want)[:]))
  }
}

///|
/// Our own PSS signatures must verify at every salt length, including none.
test "RSA PSS round-trips at every salt length" {
  for salt in [0, 16, 20, 32] {
    let sk = @rsa.PrivateKey::new(
      raw(n2048)[:],
      raw(e)[:],
      raw(d2048)[:],
      scheme=Pss(salt~),
    )
    let pk = sk.public()
    let sig = sk.sign(b"attack at dawn"[:])
    assert_eq(sig.length(), 256)
    assert_true(pk.verify(b"attack at dawn"[:], sig[:]))
    assert_false(pk.verify(b"attack at dusk"[:], sig[:]))
    // Deriving the salt rather than drawing it makes signing reproducible.
    assert_eq(sk.sign(b"attack at dawn"[:]), sig)
  }
}

///|
/// Everything a verifier must refuse.
test "a bad RSA signature is refused" {
  let sk = @rsa.PrivateKey::new(raw(n2048)[:], raw(e)[:], raw(d2048)[:])
  let pk = sk.public()
  let sig = sk.sign(b"hello"[:])
  assert_true(pk.verify(b"hello"[:], sig[:]))
  assert_false(pk.verify(b"hellp"[:], sig[:]))
  assert_false(pk.verify(b"hello"[:], sig[0:255]))
  assert_false(pk.verify(b"hello"[:], Bytes::make(256, b'\x00')[:]))
  for i in [0, 1, 128, 255] {
    let bent = sig.to_array()
    bent[i] = (bent[i].to_int() ^ 1).to_byte()
    assert_false(pk.verify(b"hello"[:], Bytes::from_array(bent)[:]))
  }
  // A signature under a different digest is a different scheme.
  let other = @rsa.PublicKey::new(raw(n2048)[:], raw(e)[:], digest=Sha512)
  assert_false(other.verify(b"hello"[:], sig[:]))
  assert_eq(pk.exponent(), raw(e))
  assert_eq(@base16.encode(pk.modulus()), n2048)
}
