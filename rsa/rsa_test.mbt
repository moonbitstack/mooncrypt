    ),
    (
      1024, "Sha256", "616263", "64f612e4ffe991edec899625ffe0cccdd5af5d16c4960fb801ee0295c239c7a2651841eeb5f1ab7a4069c6ecf96232650705ee64a7325de9fa984dd61a4c5331e0ecb6ba8d11da610bbe8f025b8ee8e3811d9287ccf533df6bb68b709cb9fb38f843922da8387ccf5c4dccd1456b845706e8e6fadfe93f910e8c63ada15d0236",
    ),
    (
      1024, "Sha256", "4d6f6f6e426974", "bfcfdcc8e562e0d2cbf840107d8e7e680c5538bdf1cc8e3c01ec92ba42bc6030b5695c00b45e588455307ae5de07a64167d7f8ca94f8ffcbb9d69b8550435969e061db57d322fe3ee8f3a0103a06b92074def8c46ff94f131fd94ecb5645da10a3c794edc030c5aeeec30667770c1d9824dfe14aee5a3535a0f6d7c47c6f2dbf",
    ),
    (
      1024, "Sha256", "",
      "9af4cacd19fb731480ced5ece7c26a9d5c3f597541256d29907bfe9a8d855bface86fe7318bdccc05cb9bf9188c25963b26397a59a78abcce477df5ec9d0280c2646433610ffebe26f32c0c4e7892b6ef32d15791ff6d9178c201ee6bb98422df8319a40f823e2e117644804c3cc37c5c9b6f98ac4769a46cc8ed5cb60903b3a",
    ),
    (
      1024, "Sha384", "", "3150719d25b12ad1a0f28fd6f7be8163900828c875cd931574f3d677d2686f10cac8487145a6097efbad97d59c0241ea32681d1eeebd1f074ae8052985db2f7dc23f4e65f3b08fe7767c12ea61013b43ba72b6a593c5565f5db8e411fa64fbea63fcc356a94cb49e09557dc1f7a929761d2543cb0ae3eaaa7125940aa08ca62d",
    ),
    (
      1024, "Sha384", "616263", "d9e7589f94976c8e67637a18936d886e1a6a8eda5538ffbf8e814bd3367b20a48f91c8fa8f4b5facfb30789708056774dd4e28f25aca52f510c3565621d39f245675d82c8786e3f369757709d931431a609601c7b8464dd2ba2ce3b90bba5bce40a2e0f71e7417e68a42acfa259213d79e798562688559b1ae9cbeab06109429",
    ),
    (
      1024, "Sha384", "4d6f6f6e426974", "a86ecfcb22d8a32867a3c94d1a6b271959f90ebd1779e605d96b24c020d4462838f1fc17d314622aedf1cea2261e6ffffa9cd3ab8565520e5af33ca3565992beacb30550f2f49b9d2ce2fc62b91556e9b5cd5d16b68216a7fbadac6be0dff40249e37ed8807cc2016de10d5752459f3a1994a3932003661764a21a97b03caad3",
    ),
    (
      1024, "Sha384", "",
      "a2e04c5bf4efe06f5f5bcea3a45a614358ea5ee15c9d14e61c4f37bcdc25a6779ab9f49af07f81466b2fc72e21fac81e787cb651b6e6d427ff06c02f1ba41825828f55dc6c690f2cae8517a90c815269d36f80210347476344630496e7085fbf95ca9cd40ed282f7eb15d7f1286191cb8e1325d725f433a274f8ebdbba448eda",
    ),
    (
      1024, "Sha512", "", "75e105fb8ff9aae4be76319f74dda66ba75017dbb31079486fcad014309d9b56b2f4a12adc00dc63a8021743260e43a6343bc549152564fc984ce8bcefc534411530da266c5ac84e299c7e4b86afd472cafd2e71411accf8a537ad2af1a145fe54d52114968fa99e50f9b953bf89fd894f6efc4945270abf001cf9369fe60760",
    ),
    (
      1024, "Sha512", "616263", "2e842451a609cb11130872c9e5a4870a99ef9686d977ad735c17cb75a5ff70816e20c5551afabe4f99802693ee33a32dc69c5e29b21282fe69625e2ac077fbfacf0f8a6fdd777daa276329cb613bf493547d649f3bee343a3097382d8041cc91c75c47af136c4d7b37278c8d187c7b9b1aa851e0517173755e6736f0609ab266",
    ),
    (
      1024, "Sha512", "4d6f6f6e426974", "99833cf5e6af0179049141bc37196f96187181eab1b7887ed10457d425e233bff092133dc99bdf696d67c5a58225174b8b316000f0d688549d905757a07fad21dde360234c1a0c391017641e613296476effa7502237d7971d951589fc792f2344c5b0aae55117ab463120e56722cfa58e363e39661a2cfe3847510479ac1e07",
    ),
    (
      1024, "Sha512", "",
      "a8c027a4b5035904f46b6acea537efc8589f240822216ede4407229c2fe05d20732546a1cadc468321017840e3b05098c7ef792ae54f47e38917b9be4c91f6fe9ac3021302a6db214fea489d62cbf80cc06b0edf9c02f685dac8a9d43f9d11dd408092f5659003b52858cc105a8480f4efc4bba9ecf91f6d18b36c00d88d91b7",
    ),
    (
      2048, "Sha1", "", "",
    ),
    (
      2048, "Sha1", "616263", "",
    ),
    (
      2048, "Sha1", "4d6f6f6e426974", "",
    ),
    (
      2048, "Sha1", "",
      "",
    ),
    (
      2048, "Sha224", "", "",
    ),
    (
      2048, "Sha224", "616263", "",
    ),
    (
      2048, "Sha224", "4d6f6f6e426974", "",
    ),
    (
      2048, "Sha224", "",
      "",
    ),
    (
      2048, "Sha256", "", "",
    ),
    (
      2048, "Sha256", "616263", "",
    ),
    (
      2048, "Sha256", "4d6f6f6e426974", "",
    ),
    (
      2048, "Sha256", "",
      "",
    ),
    (
      2048, "Sha384", "", "",
    ),
    (
      2048, "Sha384", "616263", "",
    ),
    (
      2048, "Sha384", "4d6f6f6e426974", "",
    ),
    (
      2048, "Sha384", "",
      "",
    ),
    (
      2048, "Sha512", "", "",
    ),
    (
      2048, "Sha512", "616263", "",
    ),
    (
      2048, "Sha512", "4d6f6f6e426974", "",
    ),
    (
      2048, "Sha512", "",
      "",
    ),
  ]
  for case in cases {
    let (bits, name, msg, want) = case
    let (n, d) = modulus(bits)
    let digest = digest_of(name)
    let sk = @rsa.PrivateKey::new(raw(n)[:], raw(e)[:], raw(d)[:], digest~)
    assert_eq(@base16.encode(sk.sign(raw(msg)[:])), want)
    let pk = @rsa.PublicKey::new(raw(n)[:], raw(e)[:], digest~)
    assert_true(pk.verify(raw(msg)[:], raw(want)[:]))
    assert_eq(pk.size(), bits / 8)
  }
}

///|
/// PSS salts at random, so a foreign signature can only be verified, not
/// reproduced — which is why the salt length is read back out of the block
/// instead of assumed.
test "RSA PSS verifies a third-party signer" {
  let cases = [
    (
      1024, "Sha1", "", "2951d000f793735165e0b2a478f7ce7177ccef7e2a85499c4b685e6c0f8b537d54a57b149eab73c627d347b0a0b72bbbc9d0b96bdce28c66de2e5c3603c2704f1ed1f50fcf4bef77b4728181337eab032f986ed23009c824171ddad51d99a32b28985af0c6ba335c7d60496f34ea4d60a431999eeee0c6e26c3323c652a0a5cf",
    ),
