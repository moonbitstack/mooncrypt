///|
/// C1, C2 and C3 (RFC 5794 §2.2): the first 384 bits of the fractional part of 1/π.
let constants : FixedArray[Bytes] = [
  b"\x51\x7c\xc1\xb7\x27\x22\x0a\x94\xfe\x13\xab\xe8\xfa\x9a\x6e\xe0", b"\x6d\xb1\x4a\xcc\x9e\x21\xc8\x20\xff\x28\xb1\xd5\xef\x5d\xe2\xb0",
  b"\xdb\x92\x37\x1d\x21\x26\xe9\x70\x03\x24\x97\x75\x04\xe8\xc9\x0e",
]

///|
/// The diffusion layer A (RFC 5794 §2.4.3), row by row: output byte `i` is the XOR of the input
/// bytes listed in row `i`.
let diffusion : FixedArray[FixedArray[Int32]] = [
  [3, 4, 6, 8, 9, 13, 14],
  [2, 5, 7, 8, 9, 12, 15],
  [1, 4, 6, 10, 11, 12, 15],
  [0, 5, 7, 10, 11, 13, 14],
  [0, 2, 5, 8, 11, 14, 15],
  [1, 3, 4, 9, 10, 14, 15],
  [0, 2, 7, 9, 10, 12, 13],
  [1, 3, 6, 8, 11, 12, 13],
  [0, 1, 4, 7, 10, 13, 15],
  [0, 1, 5, 6, 11, 12, 14],
  [2, 3, 5, 6, 8, 13, 15],
  [2, 3, 4, 7, 9, 12, 14],
  [1, 2, 6, 7, 9, 11, 12],
  [0, 3, 6, 7, 8, 10, 13],
  [0, 3, 4, 5, 9, 11, 14],
  [1, 2, 4, 5, 8, 10, 15],
]

///|
/// The right rotations, in bits, that turn W0 to W3 into round keys four at a time (RFC 5794
/// §2.2): >>> 19, >>> 31, <<< 61, <<< 31 and <<< 19, the left ones written as right ones.
let turns : FixedArray[Int32] = [19, 31, 67, 97, 109]

///|
fn of_view(v : BytesView) -> FixedArray[Byte] {
  FixedArray::makei(16, i => v[i])
}

///|
fn xor(a : FixedArray[Byte], b : FixedArray[Byte]) -> FixedArray[Byte] {
  FixedArray::makei(16, i => a[i] ^ b[i])
}

///|
/// The odd rounds' substitution, SB1 SB2 SB3 SB4 across each four bytes.
fn sl1(x : FixedArray[Byte]) -> FixedArray[Byte] {
  FixedArray::makei(16, i => {
    let b = x[i].to_int()
    match i % 4 {
      0 => sb1[b]
      1 => sb2[b]
      2 => sb3[b]
      _ => sb4[b]
    }
  })
}

///|
/// The even rounds' substitution, SB3 SB4 SB1 SB2: the inverse of `sl1`.
fn sl2(x : FixedArray[Byte]) -> FixedArray[Byte] {
  FixedArray::makei(16, i => {
    let b = x[i].to_int()
    match i % 4 {
      0 => sb3[b]
      1 => sb4[b]
      2 => sb1[b]
      _ => sb2[b]
    }
  })
}

///|
fn a(x : FixedArray[Byte]) -> FixedArray[Byte] {
  FixedArray::makei(16, i => {
    let mut y = b'\x00'
    for j in diffusion[i] {
      y = y ^ x[j]
    }
    y
  })
}

///|
fn fo(d : FixedArray[Byte], rk : FixedArray[Byte]) -> FixedArray[Byte] {
  a(sl1(xor(d, rk)))
}

///|
fn fe(d : FixedArray[Byte], rk : FixedArray[Byte]) -> FixedArray[Byte] {
  a(sl2(xor(d, rk)))
}

///|
/// `x` rotated right by `n` bits, taken as one 128-bit number with byte 0 most significant.
fn rotr(x : FixedArray[Byte], n : Int32) -> FixedArray[Byte] {
  let (q, r) = (n / 8, n % 8)
  FixedArray::makei(16, i => {
    let hi = x[(i - q + 16) % 16].to_int()
    if r == 0 {
      return hi.to_byte()
    }
    let lo = x[(i - q + 15) % 16].to_int()
    (((lo << (8 - r)) & 0xff) | (hi >> r)).to_byte()
  })
}

///|
/// An ARIA key schedule: the encryption round keys and the decryption ones.
pub struct Cipher {
  ek : FixedArray[FixedArray[Byte]]
  dk : FixedArray[FixedArray[Byte]]
}

///|
/// Expand a 16, 24 or 32-byte key (RFC 5794 §2.2).
pub fn Cipher::new(key : BytesView) -> Cipher raise @spec.Broken {
  let size = key.length()
  guard size == 16 || size == 24 || size == 32 else {
    raise Size(want=32, got=size)
  }
  let kl = FixedArray::makei(16, i => key[i])
  let kr = FixedArray::makei(16, i => {
    if 16 + i < size {
      key[16 + i]
    } else {
      b'\x00'
    }
  })
  // The key length rotates which of C1, C2 and C3 comes first.
  let first = (size - 16) / 8
  let ck = (i : Int32) => of_view(constants[(first + i) % 3][:])
  let w0 = kl
  let w1 = xor(fo(w0, ck(0)), kr)
  let w2 = xor(fe(w1, ck(1)), w0)
  let w3 = xor(fo(w2, ck(2)), w1)
  let w = [w0, w1, w2, w3]
  let rounds = (size - 16) / 4 + 12
  let ek = FixedArray::makei(rounds + 1, i => {
    let j = i % 4
    xor(w[j], rotr(w[(j + 1) % 4], turns[i / 4]))
  })
  let dk = FixedArray::makei(rounds + 1, i => {
    if i == 0 || i == rounds {
      ek[rounds - i]
    } else {
      a(ek[rounds - i])
    }
  })
  { ek, dk, }
}

///|
/// The rounds under `keys`: odd and even round functions in turn, then SL2 between the last two
/// keys. Encryption and decryption differ only in the keys.
fn run(keys : FixedArray[FixedArray[Byte]], input : BytesView) -> Bytes {
  let n = keys.length() - 1
  let mut p = of_view(input)
  for i in 0..<(n - 1) {
    p = if i % 2 == 0 { fo(p, keys[i]) } else { fe(p, keys[i]) }
  }
  let out = xor(sl2(xor(p, keys[n - 1])), keys[n])
  Bytes::makei(16, i => out[i])
}

///|
/// Encrypt one 16-byte block.
pub fn Cipher::encrypt(self : Cipher, input : BytesView) -> Bytes {
  guard input.length() == block else {
    abort("aria: a block is 16 bytes, not \{input.length()}")
  }
  run(self.ek, input)
}

///|
/// Decrypt one 16-byte block.
pub fn Cipher::decrypt(self : Cipher, input : BytesView) -> Bytes {
  guard input.length() == block else {
    abort("aria: a block is 16 bytes, not \{input.length()}")
  }
  run(self.dk, input)
}

///|
/// The block length in bytes.
pub fn Cipher::block(self : Cipher) -> Int32 {
  ignore(self)
  block
}

///|
/// Overwrite both schedules: either decrypts everything the key does.
pub fn Cipher::wipe(self : Cipher) -> Unit {
  for k in self.ek {
    @spec.wipe(k)
  }
  for k in self.dk {
    @spec.wipe(k)
  }
}

///|
pub impl @spec.Block for Cipher with fn block(self) {
  self.block()
}

///|
pub impl @spec.Block for Cipher with fn encrypt(self, input) {
  self.encrypt(input)
}

///|
pub impl @spec.Block for Cipher with fn decrypt(self, input) {
  self.decrypt(input)
}

///|
pub impl @spec.Block for Cipher with fn encrypt_blocks(self, input) {
  @spec.blockwise(input, block, b => self.encrypt(b))
}

///|
pub impl @spec.Block for Cipher with fn decrypt_blocks(self, input) {
  @spec.blockwise(input, block, b => self.decrypt(b))
}

///|
pub extend Cipher with @spec.Block::{decrypt_blocks, encrypt_blocks}
