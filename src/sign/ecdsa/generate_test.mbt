    b"\xe4\xb8\x51\x7f\x20\xec\x48\x11\xf7\xd9\xe0\xcf\xa2\xec\x7e\x28\x19\x8a\x34\x1d\xec\xe5\xf7\x7a\x8d\x98\x88\x59\xb9\x44\x62\x41",
  ),
  (
    P521,
    b"\x4c\xdf\x5b\xc4\x8a\x96\x00\x7a\xbd\xa8\xac\xa4\x88\x9f\xa0\xf6\xf5\x18\x8e\x9e\x44\x2f\xa4\x93\xc2\x05\x90\x22\x1b\x0a\x1d\xd6\x55\xe3\x5c\xc0\x7a\x33\xc2\xfd\xa7\x8f\x2a\x4b\xf5\x9b\x7b\xdc\x42\x64\x54\x60\x89\xde\xf0\xa2\xfc\x1f\x14\x64\x0a\x67\xe1\x4a\xaa\x4a",
    b"\x00\x99\xbe\xb7\x89\x15\x2c\x00\xf5\x7b\x51\x59\x49\x11\x3f\x41\xed\xea\x31\x1d\x3c\x88\x5f\x49\x27\x84\x0b\x20\x44\x36\x14\x3b\xac\xab\xc6\xb9\x80\xf4\x67\x85\xfb\x4f\x1e\x54\x97\xeb\x36\xf7\xb8\x84\xc8\xa8\xc1\x13\xbd\xe1\x45\xf8\x3e\x28\xc8\x14\xcf\xc2\x95\x54",
  ),
  (
    P521,
    b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x4c\xdf\x5b\xc4\x8a\x96\x00\x7a\xbd\xa8\xac\xa4\x88\x9f\xa0\xf6\xf5\x18\x8e\x9e\x44\x2f\xa4\x93\xc2\x05\x90\x22\x1b\x0a\x1d\xd6\x55\xe3\x5c\xc0\x7a\x33\xc2\xfd\xa7\x8f\x2a\x4b\xf5\x9b\x7b\xdc\x42\x64\x54\x60\x89\xde\xf0\xa2\xfc\x1f\x14\x64\x0a\x67\xe1\x4a\xaa\x4a",
