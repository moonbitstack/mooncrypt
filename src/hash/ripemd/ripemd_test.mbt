// The vectors come from `scripts/gen_ripemd_vectors.py`, which writes the
// algorithm out from the specification and refuses to emit unless it agrees with
// PyCryptodome on every case and with the three published digests.

///|
fn raw(text : String) -> Bytes {
  @base16.decode_lossy(text)
}

///|
/// One digest: the message as hex, and the twenty bytes it hashes to.
struct Case {
  msg : String
  expected : String
}

///|
/// The lengths are chosen around the padding boundaries — 55 and 56 straddle the
/// point where a message needs a second block, 63 to 65 the block size itself, and
/// 119 and 120 the same boundary one block later.
let cases : Array[Case] = [
  { msg: "", expected: "9c1185a5c5e9fc54612808977ee8f548b2258d31", },
  { msg: "61", expected: "0bdc9d2d256b3ee9daae347be6f4dc835a467ffe", },
  { msg: "616263", expected: "8eb208f7e05d987a9b044a8e98c6b087f15a0bfc", },
  {
    msg: "6d65737361676520646967657374",
    expected: "5d0689ef49d2fae572b881b123a85ffa21595f36",
  },
  {
    msg: "6162636465666768696a6b6c6d6e6f707172737475767778797a",
    expected: "f71c27109c692c1b56bbdceb5b9d2865b3708dbc",
  },
  {
    msg: "4142434445464748494a4b4c4d4e4f505152535455565758595a6162636465666768696a6b6c6d6e6f707172737475767778797a30313233343536373839",
    expected: "b0e20b6e3116640286ed3a87a5713079b21f5189",
  },
  {
    msg: "3132333435363738393031323334353637383930313233343536373839303132333435363738393031323334353637383930313233343536373839303132333435363738393031323334353637383930",
    expected: "9b752e45573d4b39f4dbd3323cab82bf63326bfb",
  },
  {
    msg: "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f30313233343536",
    expected: "3c86963b3ff646a65ae42996e9664c747cc7e5e6",
  },
  {
    msg: "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031323334353637",
    expected: "ebdd79cfd4fd9949ef8089673d2620427f487cfb",
  },
  {
    msg: "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e",
    expected: "6d31d3d634b4a7aa15914c239576eb1956f2d9a4",
  },
  {
    msg: "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f",
    expected: "2581f5e9f957b44b0fa24d31996de47409dd1e0f",
  },
  {
    msg: "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f40",
    expected: "109949b95341eeea7365e8ac4d0d3883d98f709a",
  },
  {
    msg: "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f70717273747576",
    expected: "ad430b4283203a7b7f338b9d252dfdbf807402bf",
  },
  {
    msg: "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f7071727374757677",
    expected: "b89cdc109009f1982c8b34fca446953584d3f6c4",
  },
  {
    msg: "",
    expected: "aa69deee9a8922e92f8105e007f76110f381e9cf",
  },
  {
    msg: "",
    expected: "bc9086da8f98bdbc619cd20f45798786573849c3",
  },
]

///|
/// Every vector, through both the streaming and the one-shot form.
test "ripemd-160 matches the reference" {
  assert_eq(cases.length(), 16)
  for case in cases {
    let msg = raw(case.msg)
    assert_eq(@ripemd.hash(msg[:]), raw(case.expected))
    let h = @ripemd.Hasher::new()
    h.write(msg[:])
    assert_eq(h.finish(), raw(case.expected))
  }
}

///|
/// The three digests the specification publishes, written out.
test "the published digests" {
  assert_eq(
    @ripemd.hash(b""[:]),
    raw("9c1185a5c5e9fc54612808977ee8f548b2258d31"),
  )
  assert_eq(
    @ripemd.hash(@utf8.encode("abc")[:]),
    raw("8eb208f7e05d987a9b044a8e98c6b087f15a0bfc"),
  )
  assert_eq(
    @ripemd.hash(@utf8.encode("message digest")[:]),
    raw("5d0689ef49d2fae572b881b123a85ffa21595f36"),
  )
}

///|
/// A digest is twenty bytes however it was fed, and writing a message in pieces
/// gives the same answer as writing it at once — including a piece that ends in
/// the middle of a block.
test "the digest does not depend on how the message was fed" {
  let whole = raw(
    "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f",
  )
  let want = @ripemd.hash(whole[:])
  assert_eq(want.length(), 20)
  for cut in [0, 1, 31, 32, 63, 64, 65, 128] {
    let h = @ripemd.Hasher::new()
    h.write(whole[0:cut])
    h.write(whole[cut:])
    assert_eq(h.finish(), want)
  }
}

///|
/// `reset` puts the state back to the start, so one hasher can do two messages.
test "reset starts over" {
  let h = @ripemd.Hasher::new()
  h.write(@utf8.encode("abc")[:])
  let first = h.finish()
  h.reset()
  h.write(@utf8.encode("abc")[:])
  assert_eq(h.finish(), first)
  h.reset()
  h.write(@utf8.encode("abd")[:])
  assert_true(h.finish() != first)
}

///|
/// The [`@spec.Hash`] footprint: twenty bytes, sixty-four per block.
test "the hash contract" {
  let h : &@spec.Hash = @ripemd.Hasher::new()
  assert_eq(h.size(), 20)
  assert_eq(h.block(), 64)
  // And the one-shot digest through the trait is the same as the module's own.
  assert_eq(
    @spec.digest(h, @utf8.encode("abc")[:]),
    @ripemd.hash(@utf8.encode("abc")[:]),
  )
}
