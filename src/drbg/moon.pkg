// DRBG, NIST SP 800-90A: https://doi.org/10.6028/NIST.SP.800-90A
//
// HMAC-DRBG over any hash. It implements `moonseed.Source`, so a key generator
// or a signing routine that draws from a source can take a seeded, deterministic
// generator instead of the platform's entropy — and reproduce a test vector.
import {
  "moonbitstack/moonseed",
  "moonbitstack/mooncrypt/spec",
  "moonbitstack/mooncrypt/mac/hmac",
  "moonbitstack/mooncrypt/cipher/aes",
}

import {
  "moonbitstack/moonbase/base16",
  "moonbitstack/mooncrypt/hash/sha2",
} for "test"
