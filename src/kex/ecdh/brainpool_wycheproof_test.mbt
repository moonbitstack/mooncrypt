//
// Wycheproof's ECDH vectors for the three brainpool curves RFC 5639 defines. The
// table is generated by scripts/gen_wycheproof.py; the driver is the same one
// the NIST curves use, over the same `Verdict`.

///|
test "Wycheproof: brainpool exchanges agree, and invalid points are refused" {
  let mut valid = 0
  let mut refused = 0
  for c in brainpool_cases {
    let (curve, id, scalar, peer, want, verdict) = c
    let got = Some(
      @ecdh.shared(
        @base16.decode_lossy(scalar)[:],
        @base16.decode_lossy(peer)[:],
        curve~,
      ),
    ) catch {
      _ => None
    }
    match (verdict, got) {
      (Valid, Some(secret)) => {
        assert_eq(@base16.encode(secret), want, msg="tcId \{id}")
        valid += 1
      }
      (Invalid, None) => refused += 1
      (Either, Some(secret)) =>
        assert_eq(@base16.encode(secret), want, msg="tcId \{id}")
      (Either, None) => ()
      (Valid, None) => fail("tcId \{id} is valid but was refused")
      (Invalid, Some(_)) => fail("tcId \{id} is invalid but was accepted")
    }
  }
  assert_eq(valid > 0 && refused > 0, true)
}
