// The vectors come from `scripts/gen_dh_vectors.py`, which fetches each group
// from OpenSSL, checks it against the construction RFC 7919 describes, and
// computes both sides of an exchange with CPython's own modular exponentiation.

///|
fn raw(text : String) -> Bytes {
  @base16.decode_lossy(text)
}

///|
/// One complete exchange: two exponents, the two public values they produce, and
/// the secret they agree on.
struct Case {
  group : @dh.Group
  secret : String
  peer_secret : String
  mine : String
  theirs : String
  shared : String
}

///|
/// The exchanges, one per group.
///
/// Declared once rather than inside a test because two of the tests below need
/// the same exponent, and a second copy of it is a second thing to get wrong.
let cases : Array[Case] = [
  {
    group: @dh.Ffdhe2048,
    secret: "",
    peer_secret: "",
    mine: "",
    theirs: "",
    shared: "",
  },
  {
    group: @dh.Ffdhe3072,
    secret: "",
    peer_secret: "",
    mine: "",
    theirs: "",
    shared: "",
  },
  {
    group: @dh.Ffdhe4096,
    secret: "",
    peer_secret: "",
    mine: "",
    theirs: "",
    shared: "",
  },
  {
    group: @dh.Ffdhe6144,
    secret: "",
    peer_secret: "",
    mine: "",
    theirs: "",
    shared: "",
  },
  {
    group: @dh.Ffdhe8192,
    secret: "",
    peer_secret: "",
    mine: "",
    theirs: "",
    shared: "",
  },
]

///|
/// Every group this library has, for the loops below.
let groups : Array[@dh.Group] = [
  @dh.Ffdhe2048,
  @dh.Ffdhe3072,
  @dh.Ffdhe4096,
  @dh.Ffdhe6144,
  @dh.Ffdhe8192,
]

///|
/// The groups are the ones RFC 7919 names: the size is in the name, the generator
/// is two, and the prime has the all-ones ends the RFC's search produces.
///
/// That last part is what makes this more than a smoke test. A prime of the right
/// length but a random one would pass a bit-count check and fail an exchange with
/// every other implementation; the RFC's primes begin and end with sixty-four
/// ones and a random one does not.
test "the groups are the ones rfc 7919 defines" {
  assert_eq(@dh.generator, 2)
  assert_eq(groups.length(), 5)
  for group in groups {
    let size = group.size()
    assert_eq(group.bits(), size * 8)
    let prime = group.prime()
    let bytes = prime.to_octets(length=size)
    assert_eq(bytes.length(), size)
    for i in 0..<8 {
      // The top and bottom sixty-four bits, all ones.
      assert_eq(bytes[i], b'\xff')
      assert_eq(bytes[size - 1 - i], b'\xff')
    }
  }
  assert_eq(@dh.Ffdhe2048.bits(), 2048)
  assert_eq(@dh.Ffdhe3072.bits(), 3072)
  assert_eq(@dh.Ffdhe4096.bits(), 4096)
  assert_eq(@dh.Ffdhe6144.bits(), 6144)
  assert_eq(@dh.Ffdhe8192.bits(), 8192)
  assert_eq(@dh.Ffdhe3072.security(), 128)
  assert_eq(@dh.Ffdhe3072.name(), "ffdhe3072")
}

///|
/// A whole exchange, five times: each side computes the other's public value from
/// its own exponent, and each side's shared secret equals the reference's.
test "both sides of an exchange agree" {
  assert_eq(cases.length(), 5)
  for case in cases {
    let size = case.group.size()
    let mine = @dh.Private::new(case.group, raw(case.secret)[:])
    let theirs = @dh.Private::new(case.group, raw(case.peer_secret)[:])
    let my_public = mine.public()
    let their_public = theirs.public()
    // Both public values are the width of the group, never shorter.
    assert_eq(my_public.length(), size)
    assert_eq(their_public.length(), size)
    assert_eq(my_public, raw(case.mine))
    assert_eq(their_public, raw(case.theirs))
    // And the two exponentiations land on the same number.
    let from_mine = mine.shared(their_public[:])
    let from_theirs = theirs.shared(my_public[:])
    assert_eq(from_mine, from_theirs)
    assert_eq(from_mine, raw(case.shared))
    // The one-shot forms are the same computation.
    assert_eq(@dh.public_key(case.group, raw(case.secret)[:]), my_public)
    assert_eq(
      @dh.shared_secret(case.group, raw(case.secret)[:], their_public[:]),
      from_mine,
    )
  }
}

///|
/// The three values that make the result independent of the secret are refused,
/// and so is a value of the wrong width.
///
/// One is a public key as good as no key: every exponent maps it to itself. Zero
/// and `p-1` are the same trick the other way round. None of them is a mistake a
/// peer makes by accident, so all three are a peer choosing them.
test "a peer value outside the group is refused" {
  let group = @dh.Ffdhe2048
  let key = @dh.Private::new(group, raw(case_a())[:])
  let size = group.size()

  // Two bytes short of the group width.
  let short = raw("0002")
  assert_true(refuses(key, short))

  let zeros : Array[Byte] = []
  let ones : Array[Byte] = []
  for _ in 0..<size {
    zeros.push(b'\x00')
    ones.push(b'\xff')
  }
  for
    bad in [
      Bytes::from_array(zeros), // 0
      Bytes::from_array(ones), // 2^2048 - 1
    ] {
    assert_true(refuses(key, bad))
  }

  // One, and p-1, written at the group width.
  let one : Array[Byte] = []
  for i in 0..<size {
    one.push(if i == size - 1 { b'\x01' } else { b'\x00' })
  }
  assert_true(refuses(key, Bytes::from_array(one)))
}

///|
/// `p-1`, which is the largest value a peer could send that has to be refused.
test "p minus one is refused" {
  let group = @dh.Ffdhe2048
  let key = @dh.Private::new(group, raw(case_a())[:])
  let prime = group.prime()
  let last = (prime - (1 : BigInt)).to_octets(length=group.size())
  assert_true(refuses(key, last))
  // One less than that is a legitimate, if unusual, public value.
  let ok = (prime - (2 : BigInt)).to_octets(length=group.size())
  let secret = key.shared(ok[:])
  assert_eq(secret.length(), group.size())
}

///|
/// A zero exponent is refused rather than producing a public key of one.
test "a zero exponent is refused" {
  let mut refused = false
  try {
    let _ = @dh.Private::new(Ffdhe2048, b"\x00"[:])
  } catch {
    _ => refused = true
  }
  assert_true(refused)
  // A single non-zero byte is a perfectly good — if small — exponent.
  let small = @dh.Private::new(Ffdhe2048, b"\x01"[:])
  assert_eq(small.public().length(), @dh.Ffdhe2048.size())
}

///|
/// The group a key was made in survives.
test "a key remembers its group" {
  for group in groups {
    let key = @dh.Private::new(group, raw(case_a())[:])
    assert_eq(key.group(), group)
  }
}

///|
/// The exponent the refusal tests use, as hex.
fn case_a() -> String {
  cases[0].secret
}

///|
/// Whether a peer value is refused, whatever kind of refusal it earns.
///
/// The kinds are distinguished where the distinction matters; here what matters
/// is that a bad peer value never comes back as a shared secret.
fn refuses(key : @dh.Private, peer : Bytes) -> Bool {
  try {
    let _ = key.shared(peer[:])
    false
  } catch {
    _ => true
  }
}
