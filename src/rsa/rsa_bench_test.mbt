// What `moon bench` measures for RSA, at both the widths a key is issued at and
// with the CRT factors present — the shape every signature and every decryption
// actually runs. The keys and the ciphertexts are fixed, so one run's numbers
// compare with the next one's:
//
//     moon bench src/rsa --target native --release
//
// The private operation is the whole of the cost here; verification and
// encryption are the public exponent and are measured by the Wycheproof replay.

///|
/// A 2048-bit key with its CRT factors, from a Wycheproof set.
let bench2048_n : String = ""

///|
let bench2048_e : String = "010001"

///|
let bench2048_d : String = ""

///|
let bench2048_p : String = "ec125cf37e310a2ff46263b9b2e0629d6390005ec88913d4fb71bd4dd856124498aaeba983d7ba2bd942e64d223feb7a23af4d605efeea6bd70d39afe99d35a3aa15e74a1768778093be0edd4a8d09b2def6dc9b67ff85764625c2e19236db4c401ce30a2572d3ecb4f969b7ad19c522c02d774465676e1a3776c54d6248348b"

///|
let bench2048_q : String = "c2742abcd9897bd4b0b671f973fc82a8f84abf5705ff88dd41948623afe9dca60dc6543390767feaebeb539576ee8bfa61b5fcbca94a7cef75a09150c540fa9694dd8004ad23718c889049219369c99f4458d4afc148f6f07df87324a96d9cf7b385dd8622414a1832f9f29446f050c2d5a6407649dc41ab70e23b3dcc22c987"

///|
let bench2048_ct : String = ""

///|
/// A 4096-bit key with its CRT factors, from a Wycheproof set.
let bench4096_n : String = ""

///|
let bench4096_e : String = "010001"

///|
let bench4096_d : String = ""

///|
let bench4096_p : String = ""

///|
let bench4096_q : String = ""

///|
let bench4096_ct : String = ""

///|
fn bench_key(w : Int32) -> @rsa.PrivateKey raise {
  let (n, e, d, p, q) = if w == 2048 {
    (bench2048_n, bench2048_e, bench2048_d, bench2048_p, bench2048_q)
  } else {
    (bench4096_n, bench4096_e, bench4096_d, bench4096_p, bench4096_q)
  }
  @rsa.PrivateKey::new_crt(
    raw(n)[:],
    raw(e)[:],
    raw(d)[:],
    raw(p)[:],
    raw(q)[:],
  )
}

///|
test "bench RSA-2048 sign, PKCS#1 v1.5" (it : @bench.T) {
  let key = bench_key(2048) catch { _ => abort("rsa: the benchmark key") }
  it.bench(fn() { it.keep(key.sign(b"the quick brown fox"[:])) })
}

///|
test "bench RSA-2048 decrypt, PKCS#1 v1.5" (it : @bench.T) {
  let key = bench_key(2048) catch { _ => abort("rsa: the benchmark key") }
  let cipher = raw(bench2048_ct)
  it.bench(fn() {
    it.keep(
      key.decrypt_pkcs1(cipher[:]) catch {
        _ => abort("rsa: the benchmark ciphertext")
      },
    )
  })
}

///|
test "bench RSA-4096 sign, PKCS#1 v1.5" (it : @bench.T) {
  let key = bench_key(4096) catch { _ => abort("rsa: the benchmark key") }
  it.bench(fn() { it.keep(key.sign(b"the quick brown fox"[:])) })
}

///|
test "bench RSA-4096 decrypt, PKCS#1 v1.5" (it : @bench.T) {
  let key = bench_key(4096) catch { _ => abort("rsa: the benchmark key") }
  let cipher = raw(bench4096_ct)
  it.bench(fn() {
    it.keep(
      key.decrypt_pkcs1(cipher[:]) catch {
        _ => abort("rsa: the benchmark ciphertext")
      },
    )
  })
}
