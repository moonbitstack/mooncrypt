//
// NIST's ACVP vectors for ML-DSA, from ACVP-Server's ML-DSA-keyGen-FIPS204,
// ML-DSA-sigGen-FIPS204 and ML-DSA-sigVer-FIPS204. The tables in
// `vectors_*_test.mbt` are generated by scripts/gen_acvp_vectors.py.
//
// The signing groups cover every combination of interface, pre-hash and
// randomised-or-not; the generator keeps three cases of each, which is what
// covers the combinations without committing megabytes of signature to the
// repository. `--full` emits them all.

///|
fn prehash_of(tag : String) -> @mldsa.PreHash? {
  match tag {
    "prehash:sha2-224" => Some(@mldsa.Sha2_224)
    "prehash:sha2-256" => Some(@mldsa.Sha2_256)
    "prehash:sha2-384" => Some(@mldsa.Sha2_384)
    "prehash:sha2-512" => Some(@mldsa.Sha2_512)
    "prehash:sha2-512/224" => Some(@mldsa.Sha2_512_224)
    "prehash:sha2-512/256" => Some(@mldsa.Sha2_512_256)
    "prehash:sha3-224" => Some(@mldsa.Sha3_224)
    "prehash:sha3-256" => Some(@mldsa.Sha3_256)
    "prehash:sha3-384" => Some(@mldsa.Sha3_384)
    "prehash:sha3-512" => Some(@mldsa.Sha3_512)
    "prehash:shake-128" => Some(@mldsa.Shake128)
    "prehash:shake-256" => Some(@mldsa.Shake256)
    _ => None
  }
}

///|
fn check_keygen(
  kind : @mldsa.Kind,
  cases : Array[(String, String, String)],
) -> Unit raise {
  for (seed, pk, sk) in cases {
    let key = @mldsa.PrivateKey::from_seed(kind~, @base16.decode_lossy(seed)[:])
    assert_eq(@base16.encode(key.public_key().bytes()), pk)
    assert_eq(@base16.encode(key.bytes()), sk)
  }
}

///|
test "ACVP: key generation derives the standard's pairs" {
  check_keygen(@mldsa.D44, keygen_d44)
  check_keygen(@mldsa.D65, keygen_d65)
  check_keygen(@mldsa.D87, keygen_d87)
}

///|
fn check_siggen(
  kind : @mldsa.Kind,
  cases : Array[(String, String, String, String, String, String)],
) -> Unit raise {
  for (tag, msg, context, sk, rnd, sig) in cases {
    let key = @mldsa.PrivateKey::new(kind~, @base16.decode_lossy(sk)[:])
    let message = @base16.decode_lossy(msg)
    let ctx = @base16.decode_lossy(context)
    let got = if rnd == "" {
      match prehash_of(tag) {
        None => key.sign(message[:], context=ctx[:])
        Some(p) => key.sign(message[:], context=ctx[:], prehash=p)
      }
    } else {
      let source = @moonseed.Replay::new(@base16.decode_lossy(rnd))
      match prehash_of(tag) {
        None => key.sign_randomized(message[:], source, context=ctx[:])
        Some(p) =>
          key.sign_randomized(message[:], source, context=ctx[:], prehash=p)
      }
    }
    assert_eq(@base16.encode(got), sig, msg="group \{tag}")
  }
}

///|
test "ACVP: signing reproduces the standard's signatures" {
  check_siggen(@mldsa.D44, siggen_d44)
  check_siggen(@mldsa.D65, siggen_d65)
  check_siggen(@mldsa.D87, siggen_d87)
}

///|
fn check_sigver(
  kind : @mldsa.Kind,
  cases : Array[(String, String, String, String, String, Bool)],
) -> Unit raise {
  let mut accepted = 0
  let mut refused = 0
  for (tag, pk, msg, context, sig, pass) in cases {
    let key = @mldsa.PublicKey::new(kind~, @base16.decode_lossy(pk)[:])
    let message = @base16.decode_lossy(msg)
    let ctx = @base16.decode_lossy(context)
    let signature = @base16.decode_lossy(sig)
    let got = match prehash_of(tag) {
      None => key.verify(message[:], signature[:], context=ctx[:])
      Some(p) => key.verify(message[:], signature[:], context=ctx[:], prehash=p)
    }
    assert_eq(got, pass, msg="group \{tag}")
    if got {
      accepted += 1
    } else {
      refused += 1
    }
  }
  assert_true(accepted > 0 && refused > 0)
}

///|
test "ACVP: verification accepts and refuses as it should" {
  check_sigver(@mldsa.D44, sigver_d44)
  check_sigver(@mldsa.D65, sigver_d65)
  check_sigver(@mldsa.D87, sigver_d87)
}
