  "moonbitstack/mooncrypt/aead/siv",
  "moonbitstack/mooncrypt/sign/ed25519",
  "moonbitstack/mooncrypt/sign/ed448",
  "moonbitstack/mooncrypt/sign/ecdsa",
  "moonbitstack/mooncrypt/sign/sm2",
